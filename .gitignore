# Rahasia lokal Streamlit — jangan pernah commit
.streamlit/secrets.toml

# Environment dan virtual environment
.env
.env.*
venv/
.venv/

# Database SQLite dapat berisi data keuangan, hash password, dan audit log.
# Catatan: aturan ini tidak otomatis melepas file .db yang sudah terlanjur dilacak Git.
database/*.db
database/*.db-*

# Cache Python dan pengujian
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
